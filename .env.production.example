# Telegram
# NEVER commit a real bot token. Put it in GitHub Codespaces/Actions secrets.
BOT_TOKEN=PASTE_NEW_BOTFATHER_TOKEN_HERE
# Один или несколько Telegram ID через запятую
ADMIN_IDS=PASTE_YOUR_TELEGRAM_ID_HERE

# PostgreSQL
POSTGRES_DB=orbita
POSTGRES_USER=orbita
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://orbita:CHANGE_TO_LONG_RANDOM_PASSWORD@postgres:5432/orbita

# Redis
REDIS_URL=redis://redis:6379/0

# Dating settings
MIN_AGE=18
MAX_AGE=99
FREE_DAILY_LIKES=20
VIP_DAILY_LIKES=200
MAX_PHOTOS=5
ANTISPAM_SECONDS=2

# Telegram Stars VIP (реальные Telegram Stars XTR для оплаты VIP)
STARS_VIP_PRICE=100
VIP_DAYS=30

# Внутренняя автоматическая модерация фото
# Включите после добавления ключа провайдера.
PHOTO_MODERATION_ENABLED=false
PHOTO_MODERATION_API_KEY=PASTE_PROVIDER_API_KEY_HERE
PHOTO_MODERATION_MODEL=PASTE_PROVIDER_MODEL_HERE
PHOTO_MODERATION_POLL_SECONDS=5

# Activity lifecycle
PROFILE_INACTIVE_DAYS=7
INACTIVITY_REMINDER_DAYS=14
ACTIVITY_TOUCH_INTERVAL_SECONDS=900
ACTIVITY_WORKER_SECONDS=600

# Project author / creator
AUTHOR_NAME=zeroshka
AUTHOR_URL=https://t.me/zeroshkaoff
AUTHOR_TIKTOK_URL=https://www.tiktok.com/@zeroshkayt?_r=1&_t=ZS-99TvDfLcoAU

# Local backups volume
BACKUP_DIR=/backups
